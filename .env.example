# EmailJS — https://www.emailjs.com/docs/
# Restart dev server after changes: npm run dev
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Gmail inbox connected in EmailJS (who receives contact form messages)
VITE_EMAILJS_TO_EMAIL=your_inbox@gmail.com

# Template variables sent by the app:
# to_email, name, from_name, email, from_email, phone, message, subject, time, reply_to
#
# In EmailJS dashboard → your template → Settings tab:
# - "To email" → {{to_email}}
# - "Reply to" → {{reply_to}}
# - Connect Gmail under Email Services and re-authorize if expired
